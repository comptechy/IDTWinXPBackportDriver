# WDK build output
obj/
objfre_*/
objchk_*/
*.obj
*.lib
*.exp
*.res
build*.log
build*.wrn
build*.err
*.bak
*.bak-*

# Built user-mode tools
tools/**/*.exe
tools/**/*.ilk

# Driver runtime output
stwrtxp_log.txt

# unfixthunk.cmd is GENERATED by fixthunk.cmd at run time, in whichever
# folder it was run from. It is machine-specific - never commit one.
unfixthunk.cmd

# Crash dumps, VM images, captured logs - none of this belongs in a repo
*.dmp
*.DMP
*.vhd
*.vdi
*.vmdk
*.iso

# Editor / OS noise
Thumbs.db
desktop.ini
.vs/
*.suo
*.user
